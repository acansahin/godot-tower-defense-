layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "You used all six towers and completed the full element circle.\nBuild near several road bends, mix elements so one armour cannot counter everything, and remember Earth cannot hit flyers.\nUpgrade strong positions, sell mistakes with the red ×, and send waves early for bonus gold."
