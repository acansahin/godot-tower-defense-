[node name="Body" type="Label" parent="UI/HUD/IntroPanel/Panel/VBox"]
custom_minimum_size = Vector2(700, 350)
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "Creatures enter at the upper-left and escape at the upper-right. Stop them before they cost lives.\n\nLIGHT — longest range                 DARKNESS — slow, devastating hits\nWATER — rapid attacks and slow      FIRE — short-range rapid damage\nNATURE — poison over time            EARTH — splash damage, ground only\n\nElement circle: Light → Darkness → Water → Fire → Nature → Earth → Light.\nAttacking the next element deals ×1.75 damage; attacking your counter deals ×0.7.\n\nYou will build, observe and counter a short wave with every one of the six basic towers."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

